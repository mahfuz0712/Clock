<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg_w"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextClock
            android:id="@+id/w_time"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="h:mm" android:format24Hour="HH:mm"
            android:fontFamily="monospace" android:textStyle="bold"
            android:textColor="#00E5FF" android:textSize="30sp" />
        <TextView
            android:id="@+id/w_next"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="end" android:fontFamily="monospace"
            android:textColor="#FFB300" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_r1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:orientation="horizontal">
        <TextView android:id="@+id/w_c1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:fontFamily="monospace" android:textColor="#7FB6C2" android:textSize="12sp" android:singleLine="true" />
        <TextClock android:id="@+id/w_t1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="h:mm a" android:format24Hour="HH:mm"
            android:fontFamily="monospace" android:textStyle="bold" android:textColor="#D8F3F7" android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_r2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:orientation="horizontal">
        <TextView android:id="@+id/w_c2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:fontFamily="monospace" android:textColor="#7FB6C2" android:textSize="12sp" android:singleLine="true" />
        <TextClock android:id="@+id/w_t2" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="h:mm a" android:format24Hour="HH:mm"
            android:fontFamily="monospace" android:textStyle="bold" android:textColor="#D8F3F7" android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_r3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:orientation="horizontal">
        <TextView android:id="@+id/w_c3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:fontFamily="monospace" android:textColor="#7FB6C2" android:textSize="12sp" android:singleLine="true" />
        <TextClock android:id="@+id/w_t3" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="h:mm a" android:format24Hour="HH:mm"
            android:fontFamily="monospace" android:textStyle="bold" android:textColor="#D8F3F7" android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
