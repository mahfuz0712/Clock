<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg_s"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="12dp">
    <TextClock
        android:id="@+id/w_time"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="h:mm" android:format24Hour="HH:mm"
        android:fontFamily="monospace" android:textStyle="bold"
        android:textColor="#00E5FF" android:textSize="38sp" />
    <TextClock
        android:id="@+id/w_date"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="EEE, d MMM" android:format24Hour="EEE, d MMM"
        android:fontFamily="monospace" android:textColor="#7FB6C2" android:textSize="12sp" />
    <TextView
        android:id="@+id/w_next"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:fontFamily="monospace" android:textColor="#FFB300" android:textSize="11sp" />
</LinearLayout>
